+/*
+ * MediaProvider's StorageManager tags files with one of the external-media
+ * project IDs (1000..1003, offset by userId * PER_USER_RANGE). The FUSE
+ * daemon must forward only these two restricted ioctls to the already-open
+ * backing file. Do not expose arbitrary ioctls through this callback.
+ */
+static void pf_projectid_ioctl(fuse_req_t req, fuse_ino_t ino, unsigned int cmd,
+                               void* arg, struct fuse_file_info* fi, unsigned flags,
+                               const void* in_buf, size_t in_bufsz, size_t out_bufsz) {
+    ATRACE_CALL();
+    (void)arg;
+
+    if (flags & (FUSE_IOCTL_COMPAT | FUSE_IOCTL_UNRESTRICTED)) {
+        fuse_reply_err(req, EOPNOTSUPP);
+        return;
+    }
+
+    if (req->ctx.uid != MY_UID) {
+        fuse_reply_err(req, EPERM);
+        return;
+    }
+
+    struct fuse* fuse = get_fuse(req);
+    node* node = fuse->FromInode(ino);
+    if (!node || !fi || fi->fh == 0) {
+        fuse_reply_err(req, ENOENT);
+        return;
+    }
+
+    const string path = node->BuildPath();
+    if (!is_app_accessible_path(fuse, path, req->ctx.uid)) {
+        fuse_reply_err(req, ENOENT);
+        return;
+    }
+
+    handle* h = reinterpret_cast<handle*>(fi->fh);
+    if (h->fd < 0) {
+        fuse_reply_err(req, EBADF);
+        return;
+    }
+
+    // Project IDs are supported only for emulated external storage. Bind the
+    // project-ID user component to the user directory in the FUSE path.
+    const string emulated_prefix = string(PRIMARY_VOLUME_PREFIX) + "/";
+    if (path.compare(0, emulated_prefix.size(), emulated_prefix) != 0) {
+        fuse_reply_err(req, EOPNOTSUPP);
+        return;
+    }
+    const size_t user_start = emulated_prefix.size();
+    const size_t user_end = path.find('/', user_start);
+    if (user_end == string::npos || user_end == user_start) {
+        fuse_reply_err(req, EINVAL);
+        return;
+    }
+    const string path_user_string = path.substr(user_start, user_end - user_start);
+    char* user_end_ptr = nullptr;
+    errno = 0;
+    const long path_user_id = strtol(path_user_string.c_str(), &user_end_ptr, 10);
+    if (errno != 0 || user_end_ptr == path_user_string.c_str() || *user_end_ptr != '\0' ||
+        path_user_id < 0 || path_user_id > MAX_USER_ID) {
+        fuse_reply_err(req, EINVAL);
+        return;
+    }
+
+    struct stat backing_stat = {};
+    if (fstat(h->fd, &backing_stat) < 0) {
+        fuse_reply_err(req, errno);
+        return;
+    }
+    if (!S_ISREG(backing_stat.st_mode)) {
+        fuse_reply_err(req, EOPNOTSUPP);
+        return;
+    }
+
+    if (cmd == FS_IOC_FSGETXATTR) {
+        if (in_bufsz != 0 || out_bufsz != sizeof(struct fsxattr)) {
+            fuse_reply_err(req, EINVAL);
+            return;
+        }
+        struct fsxattr xfa = {};
+        if (ioctl(h->fd, FS_IOC_FSGETXATTR, &xfa) < 0) {
+            fuse_reply_err(req, errno);
+            return;
+        }
+        fuse_reply_ioctl(req, 0, &xfa, sizeof(xfa));
+        return;
+    }
+
+    if (cmd == FS_IOC_FSSETXATTR) {
+        if (in_bufsz != sizeof(struct fsxattr) || out_bufsz != 0 || !in_buf) {
+            fuse_reply_err(req, EINVAL);
+            return;
+        }
+        struct fsxattr xfa;
+        struct fsxattr current = {};
+        memcpy(&xfa, in_buf, sizeof(xfa));
+
+        // StorageManager performs GET, changes fsx_projid, then SET. Require
+        // every other field to remain identical so this bridge cannot be used
+        // to alter unrelated filesystem attributes.
+        if (ioctl(h->fd, FS_IOC_FSGETXATTR, &current) < 0) {
+            fuse_reply_err(req, errno);
+            return;
+        }
+        if (xfa.fsx_xflags != current.fsx_xflags ||
+            xfa.fsx_extsize != current.fsx_extsize ||
+            xfa.fsx_nextents != current.fsx_nextents ||
+            xfa.fsx_cowextsize != current.fsx_cowextsize) {
+            fuse_reply_err(req, EINVAL);
+            return;
+        }
+        const uint32_t media_project_id = xfa.fsx_projid % PER_USER_RANGE;
+        if (xfa.fsx_projid / PER_USER_RANGE != static_cast<uint32_t>(path_user_id) ||
+            media_project_id < 1000 || media_project_id > 1003) {
+            fuse_reply_err(req, EINVAL);
+            return;
+        }
+        if (ioctl(h->fd, FS_IOC_FSSETXATTR, &xfa) < 0) {
+            fuse_reply_err(req, errno);
+            return;
+        }
+        fuse_reply_ioctl(req, 0, nullptr, 0);
+        return;
+    }
+
+    fuse_reply_err(req, ENOTTY);
+}
+
 static struct fuse_lowlevel_ops ops{
@@ -2171,7 +2299,7 @@ static struct fuse_lowlevel_ops ops{
   .access = pf_access, .create = pf_create,
